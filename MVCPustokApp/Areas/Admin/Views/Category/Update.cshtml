@using MVCPustokApp.Areas.Admin.ViewModels.Category
@model UpdateCategoryVM
<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Update Category</h4>

                <form class="forms-sample" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <img src="~/assets/image/bg-images/@Model.Image" alt="" height="150" width="250"/>
                        <input type="text" asp-for="Image" hidden />
                    </div>
                    
                    <div class="form-group">
                        <label for="exampleInputName1">Name</label>
                        <input asp-for="Name" type="text" class="form-control" placeholder="Name">
                        <span asp-validation-for="Name" style="color: red"></span>
                    </div>
                   

                    <div class="form-group">
                        <label for="Photo">Image</label>
                        <input asp-for="Photo" class="form-control" placeholder="Image">
                        <span asp-validation-for="Photo" style="color: red"></span>
                    </div>
                    <button type="submit" class="btn btn-primary me-2">Submit</button>
                    <button asp-controller="category" asp-action="index" class="btn btn-light">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>


