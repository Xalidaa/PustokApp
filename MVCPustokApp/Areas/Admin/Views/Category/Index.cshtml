@using MVCPustokApp.Models
@model List<Category>
@{
    int count = 0;
}
<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Categories</h1>
    
    
    <div class="card shadow mb-4">
   
        <a asp-controller="category" asp-action="create" class="btn btn-success">Add Category</a>
        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Actions</th>
                            
                        </tr>
                    </thead>

                    
                    <tbody>
                        <!-- Product 1 -->
                        @foreach(Category category in Model)
                        {
                            count++;
                            <tr>

                                <td>@count</td>
                                <td>
                                    <img src="~/assets/image/bg-images/@category.Image" alt="" width="120"
                                         height="80" />
                                    </td>
                                <td>@category.Name</td>

                                <td class="text-center">
                                    <a asp-controller="category" asp-action="detail" asp-route-id="@category.Id" class="btn btn-primary btn-circle btn-lg">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-controller="category" asp-action="update" asp-route-id="@category.Id" class="btn btn-warning btn-circle btn-lg">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="category" asp-action="delete" asp-route-id="@category.Id" class="btn btn-danger btn-circle btn-lg">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }

                       
                    </tbody>
                </table>

            </div>
        </div>
    </div>

</div>
